# Solana RPC. A private RPC (Helius/Triton/QuickNode) is strongly recommended;
# the public endpoint is rate-limited and will drop fills under load.
RPC_URL=https://api.mainnet-beta.solana.com

# PumpPortal local-transaction endpoint. This returns an UNSIGNED transaction that
# this process signs locally — your client keys never leave this machine.
PUMPPORTAL_URL=https://pumpportal.fun/api/trade-local

# Passphrase used to derive the AES-256-GCM key for the encrypted keystore.
# If unset, the CLI prompts for it. Never commit a real value.
KEYSTORE_PASSPHRASE=

# Dashboard bind address. Keep this on loopback unless you have put real auth in
# front of it — anyone who can reach this port can move client funds.
HOST=127.0.0.1
PORT=8787

# Hard ceiling on total SOL any single block trade may deploy across all accounts.
MAX_BLOCK_TRADE_SOL=5

# Max concurrent in-flight transactions. Kept low on purpose: sequential-ish
# execution is friendlier to RPC limits and produces a clean, auditable fill order.
MAX_CONCURRENCY=3
